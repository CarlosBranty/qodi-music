# Copy to .env and adjust.
QODI_ADMIN_USER=admin
QODI_ADMIN_PASSWORD=change-me-to-a-long-password
# Optional: fixed signing secret (otherwise generated once and stored in the data volume).
QODI_JWT_SECRET=
# Host folder with your music (mounted read-only). Point Syncthing at this folder.
QODI_MUSIC_DIR=/home/youruser/Music
QODI_PORT=4040
# Host uid/gid that can read the music folder.
QODI_UID=1000
QODI_GID=1000
